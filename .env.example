# ==============================================================================
# CatFish - Finanças Pessoais (Configuração de Ambiente e Segredos)
# Copie este arquivo para .env no ambiente de desenvolvimento/produção:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR & APLICAÇÃO
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (PostgreSQL)
# ------------------------------------------------------------------------------
# Para Docker Compose interno use o host 'postgres'. Para local use 'localhost'.
DATABASE_URL=postgres://catfish_user:your_secure_db_password_here@postgres:5432/catfish_db
POSTGRES_DB=catfish_db
POSTGRES_USER=catfish_user
POSTGRES_PASSWORD=your_secure_db_password_here

# ------------------------------------------------------------------------------
# 3. CRIPTOGRAFIA SIMÉTRICA EM REPOUSO (AES-256-GCM / AppSec)
# ------------------------------------------------------------------------------
# Chave mestra de no mínimo 32 caracteres para encriptação dos tokens bancários
APP_MASTER_ENCRYPTION_KEY=your_32_bytes_random_master_encryption_key_here!
JWT_SECRET=your_jwt_secret_token_key_minimum_32_chars_here!

# ------------------------------------------------------------------------------
# 4. OPEN FINANCE BRASIL (Agregador Homologado - Ex: Pluggy / Belvo)
# ------------------------------------------------------------------------------
# Obtenha suas credenciais no dashboard: https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=your_pluggy_client_id_here
PLUGGY_CLIENT_SECRET=your_pluggy_client_secret_here
PLUGGY_WEBHOOK_SECRET=your_pluggy_webhook_secret_here
PLUGGY_BASE_URL=https://api.pluggy.ai

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (SDK @google/genai)
# ------------------------------------------------------------------------------
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
