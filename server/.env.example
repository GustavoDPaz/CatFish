# ==============================================================================
# CatFish Server - Variáveis de Ambiente Backend
# Copie para .env: cp .env.example .env
# ==============================================================================

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://catfish_user:your_secure_db_password_here@localhost:5432/catfish_db

# Criptografia AES-256-GCM em Repouso
APP_MASTER_ENCRYPTION_KEY=your_32_bytes_random_master_encryption_key_here!
JWT_SECRET=your_jwt_secret_token_key_minimum_32_chars_here!

# Open Finance (Pluggy / Belvo)
PLUGGY_CLIENT_ID=your_pluggy_client_id_here
PLUGGY_CLIENT_SECRET=your_pluggy_client_secret_here
PLUGGY_WEBHOOK_SECRET=your_pluggy_webhook_secret_here
PLUGGY_BASE_URL=https://api.pluggy.ai

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
